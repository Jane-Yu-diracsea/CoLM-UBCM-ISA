&nl_colm_forcing

   ! ----- forcing -----
   DEF_dir_forcing  = '/stu02/yuxr24/CoLM-UBCM-ISA/run/forcing/urban_site/metforcing/'

   DEF_forcing%dataset           = 'POINT'
   DEF_forcing%solarin_all_band  = .true.
   DEF_forcing%HEIGHT_V          = 37.
   DEF_forcing%HEIGHT_T          = 37.
   DEF_forcing%HEIGHT_Q          = 37.
   ! !DEF_forcing%has_snow          = .true.

   DEF_forcing%leapyear          = .true.   ! leapyear calendar
   DEF_forcing%NVAR              = 8        ! variable number of forcing data
   DEF_forcing%startyr           = 2000     ! start year of forcing data
   DEF_forcing%startmo           = 12        ! start month of forcing data
   DEF_forcing%endyr             = 2012     ! end year of forcing data
   DEF_forcing%endmo             = 10       ! end month of forcing data
   DEF_forcing%dtime             = 1800 1800 1800 1800 1800 1800 1800 1800

   DEF_forcing%fprefix(1) = 'MX-Escandon_metforcing_v1.nc'
   DEF_forcing%fprefix(2) = 'MX-Escandon_metforcing_v1.nc'
   DEF_forcing%fprefix(3) = 'MX-Escandon_metforcing_v1.nc'
   DEF_forcing%fprefix(4) = 'MX-Escandon_metforcing_v1.nc'
   DEF_forcing%fprefix(5) = 'MX-Escandon_metforcing_v1.nc'
   DEF_forcing%fprefix(6) = 'MX-Escandon_metforcing_v1.nc'
   DEF_forcing%fprefix(7) = 'MX-Escandon_metforcing_v1.nc'
   DEF_forcing%fprefix(8) = 'MX-Escandon_metforcing_v1.nc'

   DEF_forcing%vname    = 'Tair' 'Qair' 'PSurf' 'Rainf' 'Wind_E' 'Wind_N' 'SWdown' 'LWdown'
   DEF_forcing%tintalgo = 'linear' 'linear' 'linear' 'nearest' 'linear' 'linear' 'linear' 'linear'

/
